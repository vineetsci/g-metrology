# Detect text files automatically; keep binary artifacts unchanged.
* text=auto

# Preserve LF line endings for all repository text formats.
*.py text eol=lf
*.pyi text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.cff text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.lock text eol=lf
*.tex text eol=lf
*.bib text eol=lf
*.csv text eol=lf
*.tsv text eol=lf
*.xml text eol=lf
*.sh text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.rst text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf

# Preserve binary and numerical artifacts exactly.
*.nc binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.zip binary
*.gz binary
*.pyc binary
